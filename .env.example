# Copiez ce fichier en .env.local pour le développement,
# et renseignez les mêmes variables dans Vercel (Project Settings → Environment Variables) pour la production.

# --- Back-office (obligatoire pour activer /admin) ---
ADMIN_PASSWORD=change-moi
ADMIN_SESSION_SECRET=une-chaine-aleatoire-longue-et-secrete

# --- Stockage des photos de réalisations (Cloudinary — plan gratuit suffisant) ---
# Créer un compte sur https://cloudinary.com puis récupérer ces 3 valeurs dans le Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Envoi des emails du formulaire de contact (Resend — plan gratuit suffisant) ---
# Créer un compte sur https://resend.com, générer une clé API.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@rio-co.fr
CONTACT_FROM_EMAIL=RIO & CO. <onboarding@resend.dev>

# --- Prise de rendez-vous en ligne avec calcul des temps de trajet ---
# Sans ces 2 variables (+ l'adresse de départ dans src/lib/site-config.ts),
# la page Contact affiche automatiquement un simple formulaire de message.

# Base de données : connecter "Storage" → "Postgres" depuis le tableau de
# bord du projet Vercel (le POSTGRES_URL est alors injecté automatiquement).
# En local, une simple instance Postgres suffit.
POSTGRES_URL=

# Google Maps Platform : créer un projet sur https://console.cloud.google.com,
# activer les API "Distance Matrix API" et "Geocoding API", créer une clé
# API (facturation à activer sur le compte Google, le quota gratuit mensuel
# suffit largement pour ce volume d'usage).
GOOGLE_MAPS_API_KEY=
